# Use separate GIPHY client API keys for each build platform.
# Put your real values in the ignored .env file, then restart Expo.
EXPO_PUBLIC_GIPHY_API_KEY_IOS=your_ios_giphy_api_key_here
EXPO_PUBLIC_GIPHY_API_KEY_ANDROID=your_android_giphy_api_key_here
# Optional: only needed when you run the Expo web build.
EXPO_PUBLIC_GIPHY_API_KEY_WEB=your_web_giphy_api_key_here
